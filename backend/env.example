# Copy to the repo root as .env (it's gitignored). Every line is optional.

# Jarvis: Claude when a key is set, otherwise the offline rules engine.
ANTHROPIC_API_KEY=
JARVIS_MODE=auto            # auto | llm | rules
JARVIS_CONFIRM=1            # 1 = equipment changes from Jarvis wait for a human to tap Confirm

# Phone push alerts via ntfy (install the ntfy app, subscribe to this topic).
# Use a long random name: anyone who knows it can read the alerts.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
PUBLIC_URL=                 # e.g. http://192.168.1.20:8000 so notification buttons open the phone page

# Demo clock: simulated minutes per real second. 0.25 = one hour every 4 minutes.
FREEBOARD_SPEED=0.25
CORS_ORIGINS=*
