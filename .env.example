# Copy this file to .env and fill it in. .env is gitignored. Never commit real keys,
# and never put a key in a VITE_ variable, because those ship to the browser.
#
# Load it in the terminal that runs the backend:
#   set -a; . ./.env; set +a
#   .venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000

# ---------------------------------------------------------------- Claude ----
# Used by ingest (reading uploaded site plans) and by Jarvis (the assistant).
# Server only.
ANTHROPIC_API_KEY=

# --------------------------------------------------------------- Backend ----
# Optional path to a field file. Default: scenario/field.json
FREEBOARD_SCENARIO=

# ------------------------------------------- SpacetimeDB on Maincloud ----
# Live shared state: asset status, clock, what-if actions, plan steps.
# Dashboard: https://spacetimedb.com/hackutd-freeboard
SPACETIME_URL=https://maincloud.spacetimedb.com
SPACETIME_DB=hackutd-freeboard
# Token for the backend's reducer calls. The live module accepts any identity,
# so use a fresh one rather than your personal login token:
#   curl -s -X POST https://maincloud.spacetimedb.com/v1/identity
SPACETIME_TOKEN=
#
# Presets and the asset library live in a second database, hackutd-freeboard-library.
# Anyone can read it. Only its admins can write, using library/upload.py.

# ----------------------------------- Jarvis (Vinny's PR #21, not on main yet) ----
# auto uses Claude when ANTHROPIC_API_KEY is set and falls back to rules.
# llm always uses Claude. rules never calls Claude.
JARVIS_MODE=auto
JARVIS_MODEL=claude-opus-5-5
# 1: equipment changes Jarvis proposes wait for a human to tap Confirm. Keep it on.
JARVIS_CONFIRM=1
# 1: simple commands get an instant rules answer before Claude is called.
JARVIS_FAST_PATH=1
# Simulation minutes per real second, and whether the clock starts by itself
# (0 means drive time by hand with /api/sim/advance).
FREEBOARD_SPEED=0.25
FREEBOARD_AUTOSTART=1
CORS_ORIGINS=*
LOG_LEVEL=INFO

# -------------------------------------------- Jarvis phone alerts (ntfy) ----
# Off unless NTFY_TOPIC is set. Anyone who knows the topic can read the alerts,
# so use a long random name.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# Address phones can reach, so alert buttons open the phone page.
# Example: http://192.168.1.20:8000
PUBLIC_URL=

# ------------------------------------------------------------ Web console ----
# Vite only exposes VITE_ variables, and they are public. No keys here.
VITE_API=http://127.0.0.1:8000
